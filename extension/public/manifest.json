{
  "manifest_version": 3,
  "name": "ZApp",
  "short_name": "ZApp",
  "version": "0.1.0",
  "description": "A private open source Zcash wallet",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZApp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://zec.rocks/*",
    "https://*.zec.rocks/*",
    "https://api.zscan.cash/*",
    "https://zilkroad.com/*",
    "https://download.z.cash/*",
    "https://api.coingecko.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}